pipeline {
    agent any

    parameters {
        string(
            name: 'REPOSITORY_URL',
            defaultValue: '',
            description: 'Public GitHub repository URL'
        )

        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Git branch to deploy'
        )

        string(
            name: 'APP_NAME',
            defaultValue: '',
            description: 'Unique application name'
        )
    }

    environment {
        REGISTRY = 'ghcr.io'
        GITHUB_OWNER = 'hachemn'
        GITOPS_REPO = 'https://github.com/hachemn/Innodeployy-gitops.git'
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.REPOSITORY_URL?.trim()) {
                        error('REPOSITORY_URL is required.')
                    }

                    if (!params.BRANCH?.trim()) {
                        error('BRANCH is required.')
                    }

                    if (!(params.APP_NAME ==~ /[a-z0-9]([-a-z0-9]*[a-z0-9])?/)) {
                        error('APP_NAME must contain lowercase letters, numbers, or hyphens.')
                    }

                    if (!(params.REPOSITORY_URL ==~ /https:\/\/github\.com\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+(\.git)?\/?/)) {
                        error('Only public GitHub repository URLs are supported.')
                    }
                }
            }
        }

        stage('Checkout Application') {
            steps {
                dir('user-app') {
                    deleteDir()

                    git branch: params.BRANCH,
                        url: params.REPOSITORY_URL
                }
            }
        }

        stage('Validate Dockerfile') {
            steps {
                dir('user-app') {
                    sh '''
                        set -eu

                        if [ ! -f Dockerfile ]; then
                            echo "ERROR: The repository must contain a Dockerfile."
                            exit 1
                        fi

                        echo "Dockerfile found."
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                        -t ${REGISTRY}/${GITHUB_OWNER}/${APP_NAME}:${BUILD_NUMBER} \
                        -t ${REGISTRY}/${GITHUB_OWNER}/${APP_NAME}:latest \
                        user-app
                '''
            }
        }

        stage('Login to GHCR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-ghcr',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        printf '%s' "$GITHUB_TOKEN" |
                            docker login "$REGISTRY" \
                                --username "$GITHUB_USER" \
                                --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                    set -eu

                    docker push ${REGISTRY}/${GITHUB_OWNER}/${APP_NAME}:${BUILD_NUMBER}
                    docker push ${REGISTRY}/${GITHUB_OWNER}/${APP_NAME}:latest
                '''
            }
        }

        stage('Update GitOps Repository') {
            steps {
                dir('gitops') {
                    deleteDir()

                    git branch: 'main',
                        credentialsId: 'github-token',
                        url: 'https://github.com/hachemn/Innodeployy-gitops.git'

                    sh '''
                        set -eu

                        APP_DIR="apps/user-apps/${APP_NAME}"
                        APP_SUFFIX="${APP_NAME##*-}"

                        mkdir -p "$APP_DIR"

                        cat > "$APP_DIR/deployment.yaml" <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${APP_NAME}
  namespace: user-apps
  labels:
    app: ${APP_NAME}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ${APP_NAME}
  template:
    metadata:
      labels:
        app: ${APP_NAME}
    spec:
      imagePullSecrets:
        - name: ghcr-pull-secret
      containers:
        - name: web
          image: ${REGISTRY}/${GITHUB_OWNER}/${APP_NAME}:${BUILD_NUMBER}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
EOF

                        cat > "$APP_DIR/service.yaml" <<EOF
apiVersion: v1
kind: Service
metadata:
  name: ${APP_NAME}
  namespace: user-apps
spec:
  type: ClusterIP
  selector:
    app: ${APP_NAME}
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
EOF

                        cat > "$APP_DIR/ingress.yaml" <<EOF
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${APP_NAME}
  namespace: user-apps
spec:
  ingressClassName: nginx
  rules:
    - host: user-app-${APP_SUFFIX}.localhost
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ${APP_NAME}
                port:
                  number: 80
EOF

                        git add "$APP_DIR"

                        if git diff --cached --quiet; then
                            echo "No GitOps changes to commit."
                        else
                            git \
                                -c user.name="InnoDeploy Jenkins" \
                                -c user.email="jenkins@innodeploy.local" \
                                commit -m "feat: deploy ${APP_NAME} build ${BUILD_NUMBER}"
                        fi
                    '''

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-token',
                            usernameVariable: 'GIT_USERNAME',
                            passwordVariable: 'GIT_TOKEN'
                        )
                    ]) {
                        sh '''
                            set +x
                            set -eu

                            ASKPASS_FILE="$(mktemp)"
                            trap 'rm -f "$ASKPASS_FILE"' EXIT

                            cat > "$ASKPASS_FILE" <<'ASKPASS'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\\n' "$GIT_USERNAME" ;;
    *Password*) printf '%s\\n' "$GIT_TOKEN" ;;
    *) exit 1 ;;
esac
ASKPASS

                            chmod 700 "$ASKPASS_FILE"

                            export GIT_ASKPASS="$ASKPASS_FILE"
                            export GIT_TERMINAL_PROMPT=0

                            git push "$GITOPS_REPO" HEAD:main
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Application image built and pushed successfully.'
            echo 'GitOps manifests updated successfully.'
            echo 'Argo CD should now reconcile the application manifests.'
        }

        failure {
            echo 'User application pipeline failed. Check the stage logs.'
        }

        always {
            sh 'docker logout ghcr.io || true'
        }
    }
}
